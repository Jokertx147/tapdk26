<Project Sdk="Microsoft.NET.Sdk">

  <!-- The screens' logic (view models) with no UI toolkit in it, so it can be tested without a window and reused by any UI. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TheAirline.Presentation</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheAirline.Core\TheAirline.Core.csproj" />
  </ItemGroup>

</Project>
