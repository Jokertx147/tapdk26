<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>TheAirline.Tests</RootNamespace>
    <AssemblyName>TheAirline.Tests</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Tests use Microsoft.VisualStudio.TestTools.UnitTesting (MSTest), Moq and Ninject. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.*" />
    <PackageReference Include="MSTest.TestFramework" Version="3.*" />
    <PackageReference Include="Moq" Version="4.*" />
    <PackageReference Include="Ninject" Version="3.*" />
    <PackageReference Include="Ninject.MockingKernel" Version="3.*" />
    <PackageReference Include="Ninject.MockingKernel.Moq" Version="3.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheAirline\TheAirline.csproj" />
  </ItemGroup>

</Project>
