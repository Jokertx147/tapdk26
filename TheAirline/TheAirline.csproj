<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>TheAirline</RootNamespace>
    <AssemblyName>TheAirline</AssemblyName>
    <ApplicationIcon>TheAirline.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- AssemblyInfo.cs and AssemblyVersionInfo.cs already define the assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- AssemblyInfo.cs uses AssemblyVersion("2.0.*"), which needs a non-deterministic build. -->
    <Deterministic>false</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Lets old .NET Framework only packages and DLLs restore; warnings point at the ones to replace. -->
    <AssetTargetFallback>$(AssetTargetFallback);net48;net472;net461;net45;net40</AssetTargetFallback>
    <NoWarn>$(NoWarn);NU1701;MSB3277</NoWarn>
  </PropertyGroup>

  <!-- Source files the old project never compiled. They were stale copies and old EF6 migrations. -->
  <ItemGroup>
    <Compile Remove="Migrations\201505231846321_Regions.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.*" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NLog" Version="5.*" />
    <PackageReference Include="Prism.DryIoc" Version="9.*" />
    <PackageReference Include="System.Runtime.Caching" Version="10.*" />
    <PackageReference Include="WpfLocalizeExtension" Version="3.*" />
    <PackageReference Include="WPFTaskDialog" Version="1.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TheAirline.Data\TheAirline.Data.csproj" />
  </ItemGroup>

  <!-- Designer-generated files -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Language files live in the shared Data folder and are embedded under their old names. -->
  <ItemGroup>
    <Compile Include="..\Data\Data\languages\language.Designer.cs">
      <Link>Data\languagefiles\language.Designer.cs</Link>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>language.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Include="..\Data\Data\languages\language.da-DK.resx">
      <Link>Data\languagefiles\language.da-DK.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Data\Data\languages\language.de-DE.resx">
      <Link>Data\languagefiles\language.de-DE.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Data\Data\languages\language.en-GB.resx">
      <Link>Data\languagefiles\language.en-GB.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Data\Data\languages\language.es-ES.resx">
      <Link>Data\languagefiles\language.es-ES.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Data\Data\languages\language.nl-NL.resx">
      <Link>Data\languagefiles\language.nl-NL.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Data\Data\languages\language.resx">
      <Link>Data\languagefiles\language.resx</Link>
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>language.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Data\Data\languages\language.zh-CN.resx">
      <Link>Data\languagefiles\language.zh-CN.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Data\Data\languages\language.it-IT.resx">
      <Link>Data\languagefiles\language.it-IT.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Data\Data\languages\language.ru-RU.resx">
      <Link>Data\languagefiles\language.ru-RU.resx</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Data\Data\languages\language.tr-TR.resx">
      <Link>Data\languagefiles\language.tr-TR.resx</Link>
    </EmbeddedResource>
  </ItemGroup>

