  <ItemGroup>
    <Content Include="NLog.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Include="NLog.xsd" />
  </ItemGroup>

  <!-- The game reads its XML data from a "data" folder next to the executable. -->
  <ItemGroup>
    <GameData Include="..\Data\Data\**\*" Exclude="..\Data\Data\saves\**" />
  </ItemGroup>
  <Target Name="CopyGameData" AfterTargets="Build" Inputs="@(GameData)" Outputs="@(GameData->'$(OutDir)data\%(RecursiveDir)%(Filename)%(Extension)')">
    <Copy SourceFiles="@(GameData)" DestinationFiles="@(GameData->'$(OutDir)data\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- dotnet publish only copies the build output, so the game data has to be added to the publish folder as well. -->
  <Target Name="CopyGameDataToPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(GameData)" DestinationFiles="@(GameData->'$(PublishDir)data\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
