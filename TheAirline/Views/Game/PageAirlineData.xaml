<UserControl x:Class="TheAirline.Views.Game.PageAirlineData"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:TheAirline.Infrastructure.Converters"
             xmlns:game="clr-namespace:TheAirline.ViewModels.Game"
             xmlns:lex="http://wpflocalizeextension.codeplex.com"
             lex:LocalizeDictionary.DesignCulture="en"
             lex:ResxLocalizationProvider.DefaultAssembly="TheAirline"
             lex:ResxLocalizationProvider.DefaultDictionary="language"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance game:PageAirlineDataViewModel}"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <system:Boolean x:Key="True">True</system:Boolean>
        <system:Boolean x:Key="False">False</system:Boolean>
        <converters:RadioButtonCheckedConverter x:Key="RadioButtonCheckedConverter" />
    </UserControl.Resources>
    <StackPanel HorizontalAlignment="Center">
        <Grid>
            <Grid.Resources>
                <Style TargetType="{x:Type TextBlock}">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="FontWeight" Value="Bold" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="175" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- airline -->
            <TextBlock Grid.Column="0" Grid.Row="0" Text="{lex:Loc PageNewGame_1002_name}" />
            <ComboBox Grid.Column="1" Grid.Row="0" Width="300" Margin="0 0 0 5" HorizontalAlignment="Left"
                      Style="{DynamicResource ComboBoxTransparentStyle}"
                      ItemTemplate="{StaticResource AirlineCountryItem}"
                      ItemsSource="{Binding Airlines}" SelectedItem="{Binding SelectedAirline}" />

            <!-- airline type: passenger, cargo or mixed -->
            <TextBlock Grid.Column="0" Grid.Row="1" Text="{lex:Loc PageNewGame_1021_name}" />
            <TextBlock Grid.Column="1" Grid.Row="1" Margin="0 0 0 5" FontWeight="Normal" Text="{Binding RouteFocus}" />

            <!-- CEO -->
            <TextBlock Grid.Column="0" Grid.Row="2" Text="{lex:Loc PageNewGame_1005_name}" />
            <TextBox Grid.Column="1" Grid.Row="2" Width="300" Margin="0 0 0 5" HorizontalAlignment="Left"
                     Text="{Binding Ceo, UpdateSourceTrigger=PropertyChanged}" />

            <!-- country -->
            <TextBlock Grid.Column="0" Grid.Row="3" Text="{lex:Loc PageNewGame_1004_name}" />
            <ComboBox Grid.Column="1" Grid.Row="3" Width="300" Margin="0 0 0 5" HorizontalAlignment="Left"
                      Style="{StaticResource ComboBoxTransparentStyle}"
                      ItemTemplate="{StaticResource CountryLongFlagItem}"
                      ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}" />

            <!-- local currency -->
            <TextBlock Grid.Column="0" Grid.Row="4" Text="{lex:Loc PageNewGame_1014_name}" />
            <WrapPanel Grid.Column="1" Grid.Row="4" HorizontalAlignment="Left" Margin="0 0 0 5">
                <RadioButton GroupName="Currency" Content="{lex:Loc General_106_name}"
                             Style="{StaticResource RadioButtonLeftSideText}" VerticalAlignment="Bottom"
                             IsChecked="{Binding UseLocalCurrency, Converter={StaticResource RadioButtonCheckedConverter}, ConverterParameter={StaticResource True}}" />
                <RadioButton GroupName="Currency" Content="{lex:Loc General_107_name}"
                             Style="{StaticResource RadioButtonLeftSideText}" VerticalAlignment="Bottom"
                             Margin="5 0 0 0"
                             IsChecked="{Binding UseLocalCurrency, Converter={StaticResource RadioButtonCheckedConverter}, ConverterParameter={StaticResource False}}" />
            </WrapPanel>

            <!-- home airport -->
            <TextBlock Grid.Column="0" Grid.Row="5" Text="{lex:Loc PageNewGame_1007_name}" />
            <ComboBox Grid.Column="1" Grid.Row="5" Width="300" Margin="0 0 0 5" HorizontalAlignment="Left"
                      Style="{DynamicResource ComboBoxTransparentStyle}"
                      ItemTemplate="{StaticResource AirportCountryItem}"
                      ItemsSource="{Binding Airports}" SelectedItem="{Binding SelectedAirport}" />

            <!-- time zone -->
            <TextBlock Grid.Column="0" Grid.Row="6" Text="{lex:Loc PageNewGame_1009_name}" />
            <ComboBox Grid.Column="1" Grid.Row="6" Width="300" Margin="0 0 0 5" HorizontalAlignment="Left"
                      Style="{DynamicResource ComboBoxTransparentStyle}" DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding TimeZones}" SelectedItem="{Binding SelectedTimeZone}" />
        </Grid>

        <TextBlock Width="500" Padding="5" FontStyle="Italic" TextWrapping="Wrap" Text="{Binding Narrative}"
                   HorizontalAlignment="Left">
            <TextBlock.Background>
                <SolidColorBrush Color="Black" Opacity="0.8" />
            </TextBlock.Background>
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Style.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Margin="0 10 0 0" Text="Creating game..." FontWeight="Bold">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCreating}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <WrapPanel Margin="0 10 0 0">
            <Button Style="{DynamicResource StandardButtonStyle}" Content="{lex:Loc PageNewGame_201_name}"
                    Width="NaN" Command="{Binding CreateGameCommand}" />
            <Button Style="{DynamicResource StandardButtonStyle}" Content="{lex:Loc General_119_name}" Width="NaN"
                    Margin="5 0 0 0" Command="{Binding BackCommand}" />
            <Button Style="{DynamicResource StandardButtonStyle}" Content="{lex:Loc PageNewGame_202_name}"
                    Width="NaN" Margin="5 0 0 0" Command="{Binding StartMenuCommand}" />
        </WrapPanel>
    </StackPanel>
</UserControl>
