<Page x:Class="TheAirline.GUIModel.PagesModel.AirportPageModel.PageAirportDemand"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:chart="clr-namespace:TheAirline.GUIModel.CustomControlsModel.Charts" 
      Name="pageAirportDemand"
      mc:Ignorable="d"
      d:DesignHeight="300" d:DesignWidth="300"
      Title="PageAirportDemand">
     <Page.Resources>
        <Style x:Key="DemandRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#FF2E7D9B" Opacity="0.85" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <SolidColorBrush Color="#FF2E7D9B" Opacity="0.35" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
     <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel Grid.Row="0">
            <TextBlock FontWeight="Bold"
                       Text="{Binding Source={x:Null}, Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportDemand 1001'}"
                       VerticalAlignment="Bottom" />
            <TextBox Margin="5 0 0 0" Text="" VerticalAlignment="Bottom" Width="150"
                     TextChanged="txtSearch_TextChanged"
                     ToolTip="Search by airport name, IATA or ICAO code, city or country" />
            <TextBlock Margin="20 0 0 0" Text="Change demand by" VerticalAlignment="Bottom" FontWeight="Bold" />
            <TextBox x:Name="txtScale" Margin="5 0 0 0" Text="110" Width="45" VerticalAlignment="Bottom"
                     ToolTip="Percentage: 110 raises demand by 10%, 50 halves it" />
            <TextBlock Text="%" VerticalAlignment="Bottom" Margin="2 0 0 0" />
            <Button Margin="5 0 0 0" Content="Selected" Click="btnScaleSelected_Click"
                    Style="{StaticResource StandardButtonStyle}"
                    ToolTip="Apply to the highlighted rows" />
            <Button Margin="5 0 0 0" Content="All shown" Click="btnScaleShown_Click"
                    Style="{StaticResource StandardButtonStyle}"
                    ToolTip="Apply to every destination in the lists (after searching, only the matches)" />
            <Button Margin="5 0 0 0" Content="Undo" Click="btnUndoDemand_Click"
                    Style="{StaticResource StandardButtonStyle}"
                    ToolTip="Put every demand back to what it was when this page was opened" />
            <TextBlock x:Name="txtDemandStatus" Margin="10 0 0 0" VerticalAlignment="Bottom" Text="Click a row (not the number boxes) to highlight it; Ctrl or Shift adds more rows." />
        </WrapPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                    </Grid.ColumnDefinitions>
           <!--
                        <TextBlock
                    Text="{Binding Source={x:Null}, Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportInfo 1029'}"
                    VerticalAlignment="Bottom" Style="{StaticResource SmallHeaderStyle}" />-->
                        <ListView x:Name="lvDemandDomestic" SelectionMode="Extended" ItemContainerStyle="{StaticResource DemandRowStyle}" GridViewColumnHeader.Click="lvDemand_HeaderClick" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" Grid.Column="0"
                          ItemsSource="{Binding DomesticDemands}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel>
                                    </VirtualizingStackPanel>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <WrapPanel>
                                                    <Button Width="20" VerticalAlignment="Bottom" Tag="{Binding}" Margin="0 0 5 0"
                                                Background="Transparent" Click="btnDemandContract_Click">
                                                        <Image Source="/Resources/images/add.png" 
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Contracted}" Value="True">
                                                                        <Setter Property="Button.Visibility" Value="Collapsed" />
                                                                        <Setter Property="Button.Margin" Value="0 0 0 0"></Setter>
                                                                    </DataTrigger>
                                                                    <DataTrigger
                                                            Binding="{Binding HasFreeGates}"
                                                            Value="False">
                                                                        <Setter Property="Button.Visibility" Value="Collapsed" />
                                                                        <Setter Property="Button.Margin" Value="0 0 0 0"></Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Width="20" VerticalAlignment="Bottom" Tag="{Binding}"
                                                Background="Transparent" Click="btnDemandInfo_Click">
                                                        <Button.Style>
                                                            <Style>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Contracted}" Value="True">
                                                                        <Setter Property="Button.Margin" Value="0 0 0 0" />
                                                                    </DataTrigger>
                                                                    <DataTrigger
                                                            Binding="{Binding HasFreeGates}"
                                                            Value="False">
                                                                        <Setter Property="Button.Margin" Value="0 0 0 0" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Image Source="/Resources/images/info.png" 
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Button>
                                                </WrapPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn
                                Header="{Binding Source={x:Null}, Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportInfo 1030'}"
                                Width="230">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl VerticalAlignment="Bottom" Content="{Binding Destination}"
                                                        ContentTemplate="{StaticResource AirportCountryLink}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Distance" Width="85">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Distance, Converter={StaticResource DistanceToUnitConverter}}" VerticalAlignment="Bottom" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn
                                Header="{Binding Source={x:Null}, Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportInfo 1031'}"
                                Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Margin="5 0 0 0" Width="60" Text="{Binding Passengers, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Bottom" Background="Transparent" Foreground="{DynamicResource AppTextBrush}" BorderThickness="0 0 0 1" ToolTip="Edit the passenger demand" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn
                                Header="{Binding Source={x:Null}, Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportInfo 1032'}"
                                Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Width="60" Text="{Binding Cargo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Bottom" Background="Transparent" Foreground="{DynamicResource AppTextBrush}" BorderThickness="0 0 0 1" ToolTip="Edit the cargo demand" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                </GridView>
                            </ListView.View>
                        </ListView>

    
             <!--           <TextBlock
                    Text="{Binding Source={x:Null}, Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportInfo 1057'}"
                    VerticalAlignment="Bottom" Style="{StaticResource SmallHeaderStyle}" />-->
                        <ListView x:Name="lvDemandIntl" SelectionMode="Extended" ItemContainerStyle="{StaticResource DemandRowStyle}" GridViewColumnHeader.Click="lvDemand_HeaderClick" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" Grid.Column="1"
                          ItemsSource="{Binding IntlDemands}">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel>
                                    </VirtualizingStackPanel>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <WrapPanel>
                                                    <Button Width="20" VerticalAlignment="Bottom" Tag="{Binding}"  Margin="0 0 5 0"
                                                Background="Transparent" Click="btnDemandContract_Click">
                                                        <Image Source="/Resources/images/add.png"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Contracted}" Value="True">
                                                                        <Setter Property="Button.Visibility" Value="Collapsed" />
                                                                        <Setter Property="Button.Margin" Value="0 0 0 0"></Setter>

                                                                    </DataTrigger>
                                                                    <DataTrigger
                                                            Binding="{Binding HasFreeGates}"
                                                            Value="False">
                                                                        <Setter Property="Button.Visibility" Value="Collapsed" />
                                                                        <Setter Property="Button.Margin" Value="0 0 0 0"></Setter>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                    <Button Width="20" VerticalAlignment="Bottom" Tag="{Binding}" 
                                                Background="Transparent" Click="btnDemandInfo_Click">

                                                        <Image Source="/Resources/images/info.png" 
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Button>
                                                </WrapPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn
                                Header="{Binding Source={x:Null}, Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportInfo 1030'}"
                                Width="230">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ContentControl VerticalAlignment="Bottom" Content="{Binding Destination}"
                                                        ContentTemplate="{StaticResource AirportCountryLink}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Distance" Width="85">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Distance, Converter={StaticResource DistanceToUnitConverter}}" VerticalAlignment="Bottom" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn
                                Header="{Binding Source={x:Null}, Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportInfo 1031'}"
                                Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Margin="5 0 0 0" Width="60" Text="{Binding Passengers, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Bottom" Background="Transparent" Foreground="{DynamicResource AppTextBrush}" BorderThickness="0 0 0 1" ToolTip="Edit the passenger demand" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn
                                Header="{Binding Source={x:Null}, Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportInfo 1032'}"
                                Width="75">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Width="60" Text="{Binding Cargo, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Bottom" Background="Transparent" Foreground="{DynamicResource AppTextBrush}" BorderThickness="0 0 0 1" ToolTip="Edit the cargo demand" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                </GridView>
                            </ListView.View>
                        </ListView>
                  </Grid>

        <StackPanel Grid.Row="2">
            <StackPanel.Style>
                <Style>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedAirport,ElementName=pageAirportDemand}" Value="{x:Null}">
                            <Setter Property="StackPanel.Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Separator></Separator>
            <TextBlock Text="{Binding SelectedAirport.Destination.Profile.Name,ElementName=pageAirportDemand}" FontSize="12" TextDecorations="Underline" FontWeight="Bold"></TextBlock>
            
            <WrapPanel Style="{StaticResource WrapPanelStyle}">
                <TextBlock
                    Text="{Binding Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportDemand 1003'}"
                    VerticalAlignment="Bottom" FontWeight="Bold" Width="150" />
                <ContentControl ContentTemplate="{DynamicResource CountryFlagLongItem}"
                                                Content="{Binding SelectedAirport.Destination.Profile.Country,ElementName=pageAirportDemand}"></ContentControl>
                <TextBlock Text="{Binding SelectedAirport.Destination.Profile.Type}" VerticalAlignment="Bottom"></TextBlock>
            </WrapPanel>
            <WrapPanel Style="{StaticResource WrapPanelStyle}">
                <TextBlock
                    Text="{Binding Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportDemand 1004'}"
                    VerticalAlignment="Bottom" FontWeight="Bold" Width="150" />
                <TextBlock Text="{Binding SelectedAirport.Destination.Profile.Type,ElementName=pageAirportDemand,Converter={StaticResource TextUnderscoreConverter}}" VerticalAlignment="Bottom"></TextBlock>

            </WrapPanel>
            <WrapPanel Style="{StaticResource WrapPanelStyle}">
                <TextBlock
                    Text="{Binding Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportDemand 1005'}"
                    VerticalAlignment="Bottom" FontWeight="Bold" Width="150" />
                <TextBlock Text="{Binding SelectedAirport.Destination.Profile.Size,ElementName=pageAirportDemand,Converter={StaticResource TextUnderscoreConverter}}" VerticalAlignment="Bottom"></TextBlock>

            </WrapPanel>
            <WrapPanel Style="{StaticResource WrapPanelStyle}">
                <TextBlock
                    Text="{Binding Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportDemand 1002'}"
                    VerticalAlignment="Bottom" FontWeight="Bold" Width="150" />
                <TextBlock Text="{Binding SelectedAirport.Distance,ElementName=pageAirportDemand,Converter={StaticResource DistanceToUnitConverter}}" VerticalAlignment="Bottom"></TextBlock>

            </WrapPanel>
            <WrapPanel>
            <chart:PieChart Width="300" Height="300" HorizontalAlignment="Left" ItemsSource="{Binding}" ChartTitle="{Binding Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportDemand 1006'}" Foreground="{DynamicResource AppTextBrush}" x:Name="pcGates" />
                <chart:ColumnChart Width="300" Height="300" ItemsSource="{Binding}" ChartTitle="{Binding Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportDemand 1007'}" Margin="10 0 0 0" Foreground="{DynamicResource AppTextBrush}" x:Name="cccDemand" />
                <chart:PieChart Width="300" Height="300" HorizontalAlignment="Left" ItemsSource="{Binding}" ChartTitle="{Binding Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportDemand 1008'}" Margin="10 0 0 0" Foreground="{DynamicResource AppTextBrush}" x:Name="pcSeats" />
                <chart:PieChart Width="300" Height="300" HorizontalAlignment="Left" ItemsSource="{Binding}" ChartTitle="{Binding Converter={StaticResource TranslatorConverter},ConverterParameter='PageAirportDemand 1007'}" Margin="10 0 0 0" Foreground="{DynamicResource AppTextBrush}" x:Name="pcDemand" />
            </WrapPanel>
        </StackPanel>
        </Grid>

</Page>