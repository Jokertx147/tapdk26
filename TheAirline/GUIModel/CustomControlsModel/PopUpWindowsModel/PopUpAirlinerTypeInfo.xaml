<window:PopUpWindow x:Class="TheAirline.GraphicsModel.UserControlModel.PopUpWindowsModel.PopUpAirlinerTypeInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:window="clr-namespace:TheAirline.GraphicsModel.UserControlModel.PopUpWindowsModel"
        Title="Airliner" Height="640" Width="380" WindowStartupLocation="CenterScreen" Background="#004A7F">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="{Binding Type.Name}" FontSize="22" FontWeight="Bold" Margin="0 0 0 6" />
                <ContentControl Content="{Binding Type}"
                                ContentTemplate="{StaticResource AirlinerTypeSpecificationItem}" />
                <WrapPanel Style="{StaticResource WrapPanelStyle}">
                    <TextBlock Text="Price" Width="150" VerticalAlignment="Bottom" FontWeight="Bold" />
                    <TextBlock Text="{Binding Type.Price, Converter={StaticResource ValueCurrencyConverter}}"
                               VerticalAlignment="Bottom" />
                </WrapPanel>
                <WrapPanel Style="{StaticResource WrapPanelStyle}">
                    <TextBlock Text="In production" Width="150" VerticalAlignment="Bottom" FontWeight="Bold" />
                    <TextBlock Text="{Binding Produced}" VerticalAlignment="Bottom" />
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
        <Button Grid.Row="1" Content="Close" HorizontalAlignment="Right" Margin="0 8 0 0" Padding="12 0 12 0"
                Style="{StaticResource StandardButtonStyle}" IsCancel="True" IsDefault="True" Click="btnClose_Click" />
    </Grid>
</window:PopUpWindow>
