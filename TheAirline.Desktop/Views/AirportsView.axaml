<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.AirportsView">
  <Grid ColumnDefinitions="300,12,*,12,Auto" RowDefinitions="*,Auto" Margin="0,10,0,0">

    <!-- airport picker -->
    <Grid RowDefinitions="Auto,*">
      <TextBox Text="{Binding Search}" Watermark="search airport, code or country (empty = your airports)" Margin="0,0,0,6" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Airports}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- advisor -->
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*">
      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,6">
        <RadioButton GroupName="routekind" Content="Passenger routes" IsChecked="{Binding PassengerMode}" />
        <RadioButton GroupName="routekind" Content="Cargo routes" IsChecked="{Binding CargoMode}" />
        <TextBlock Text="{Binding AdviceTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.8" />
        <TextBlock Text="(best first, pick one to create it)" VerticalAlignment="Center" Opacity="0.6" />
      </StackPanel>
      <TextBox Grid.Row="1" Text="{Binding DestinationSearch}" Margin="0,0,0,6"
               Watermark="or search any destination airport (code, name or country), recommended or not" />
      <ListBox Grid.Row="2" IsVisible="{Binding IsSearchingDestinations}" ItemsSource="{Binding Destinations}" SelectedItem="{Binding SelectedDestination}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Details}" Opacity="0.7" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ListBox Grid.Row="2" IsVisible="{Binding ShowAdvice}" ItemsSource="{Binding Advice}" SelectedItem="{Binding SelectedAdvice}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Numbers}" Opacity="0.7" />
              <TextBlock Text="{Binding Notes}" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- create route -->
    <Border Grid.Column="4" IsVisible="{Binding HasCreate}" Width="340" Background="#262626" CornerRadius="6" Padding="14">
      <ScrollViewer DataContext="{Binding Create}">
        <v:CreateRouteForm />
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
  </Grid>
</UserControl>
