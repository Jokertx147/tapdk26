<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.AirportsView">
  <Grid ColumnDefinitions="300,12,*,12,Auto" RowDefinitions="*,Auto" Margin="0,10,0,0">

    <!-- airport picker -->
    <Grid RowDefinitions="Auto,*">
      <TextBox Text="{Binding Search}" Watermark="search airport, code or country (empty = your airports)" Margin="0,0,0,6" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Airports}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- advisor -->
    <Grid Grid.Column="2" RowDefinitions="Auto,*">
      <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,6">
        <RadioButton GroupName="routekind" Content="Passenger routes" IsChecked="{Binding PassengerMode}" />
        <RadioButton GroupName="routekind" Content="Cargo routes" IsChecked="{Binding CargoMode}" />
        <TextBlock Text="{Binding AdviceTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Opacity="0.8" />
        <TextBlock Text="(best first, pick one to create it)" VerticalAlignment="Center" Opacity="0.6" />
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Advice}" SelectedItem="{Binding SelectedAdvice}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Numbers}" Opacity="0.7" />
              <TextBlock Text="{Binding Notes}" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- create route -->
    <Border Grid.Column="4" IsVisible="{Binding HasCreate}" Width="340" Background="#262626" CornerRadius="6" Padding="14">
      <ScrollViewer DataContext="{Binding Create}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" />

          <ItemsControl ItemsSource="{Binding Offers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#3A2E1A" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}"
                              IsVisible="{Binding CanLease}" HorizontalAlignment="Stretch" />
                    <Button Content="Lease gates" Command="{Binding LeaseCommand}" IsVisible="{Binding CanLease}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Spacing="8" IsVisible="{Binding IsPassenger}">
            <TextBlock Text="Service" />
            <ComboBox ItemsSource="{Binding Tiers}" SelectedItem="{Binding Tier}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="8" IsVisible="{Binding IsCargo}">
            <TextBlock Text="Price per unit of cargo" />
            <TextBox Text="{Binding CargoPrice}" />
          </StackPanel>
          <TextBlock Text="{Binding AircraftLabel}" />
          <ComboBox ItemsSource="{Binding Aircraft}" SelectedItem="{Binding SelectedAircraft}" HorizontalAlignment="Stretch" />

          <StackPanel Spacing="8" IsEnabled="{Binding ScheduleEnabled}">
            <TextBlock Text="Schedule" />
            <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}" HorizontalAlignment="Stretch" IsEnabled="{Binding DetailEnabled}" />
            <TextBlock Text="Turnaround (minutes)" />
            <ComboBox ItemsSource="{Binding Turnarounds}" SelectedItem="{Binding Turnaround}" HorizontalAlignment="Stretch" IsEnabled="{Binding DetailEnabled}" />
            <TextBlock Text="Round trips per day" />
            <ComboBox ItemsSource="{Binding Trips}" SelectedItem="{Binding RoundTrips}" HorizontalAlignment="Stretch" IsEnabled="{Binding DetailEnabled}" />
            <TextBlock Text="First departure" />
            <ComboBox ItemsSource="{Binding StartTimes}" SelectedItem="{Binding StartTime}" HorizontalAlignment="Stretch" IsEnabled="{Binding DetailEnabled}" />
            <CheckBox Content="Start flying straight away" IsChecked="{Binding StartAirliner}" />
          </StackPanel>

          <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Opacity="0.85" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Create route" Command="{Binding CreateCommand}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
  </Grid>
</UserControl>
