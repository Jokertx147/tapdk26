<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.FleetPerformanceView">
  <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,*" Margin="0,10,0,0">
    <StackPanel Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Sort by" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" MinWidth="170" />
      </StackPanel>
    </StackPanel>

    <!-- the fleet, best or worst first -->
    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border IsVisible="{Binding IsLoss}" Background="#A23B3B" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Text="LOSS" FontSize="11" FontWeight="Bold" Foreground="White" />
              </Border>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="{Binding Numbers}" Opacity="0.7" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- one aircraft's history -->
    <ScrollViewer Grid.Row="1" Grid.Column="2">
      <StackPanel Spacing="6" IsVisible="{Binding HasSelection}" Margin="0,0,12,0">
        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontWeight="SemiBold" />

        <TextBlock Text="Each year" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
        <ItemsControl ItemsSource="{Binding YearLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Each month (newest first)" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="100,120,120,*" Opacity="0.7">
          <TextBlock Text="Month" />
          <TextBlock Grid.Column="1" Text="Income" />
          <TextBlock Grid.Column="2" Text="Costs" />
          <TextBlock Grid.Column="3" Text="Profit" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Months}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,3">
                <Grid ColumnDefinitions="100,120,120,*">
                  <TextBlock Text="{Binding Month}" />
                  <TextBlock Grid.Column="1" Text="{Binding Income}" />
                  <TextBlock Grid.Column="2" Text="{Binding Costs}" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Profit}" FontWeight="SemiBold" />
                    <TextBlock Text="loss" Foreground="#E07070" IsVisible="{Binding IsLoss}" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="{Binding Detail}" Opacity="0.55" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
