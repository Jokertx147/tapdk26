<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.AdvertisingView">
  <Grid ColumnDefinitions="*,16,*" Margin="0,10,0,0">

    <!-- channels and reputation -->
    <ScrollViewer>
      <StackPanel Spacing="8" Margin="0,0,8,0">
        <Border Background="#262626" CornerRadius="6" Padding="12">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding ReputationText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CostText}" Opacity="0.85" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Explanation}" Opacity="0.7" TextWrapping="Wrap" />

        <TextBlock Text="Channels" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
        <ItemsControl ItemsSource="{Binding Channels}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="120,*" Margin="0,4">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Levels}" SelectedItem="{Binding Selected}" MinWidth="260" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Running campaigns" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" IsVisible="{Binding HasCampaigns}" />
        <ItemsControl ItemsSource="{Binding Campaigns}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Stop" Command="{Binding EndCommand}" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border IsVisible="{Binding HasPending}" Background="#3a3320" CornerRadius="6" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Yes" Command="{Binding ConfirmCommand}" />
              <Button Content="No" Command="{Binding CancelCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <!-- new campaign -->
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock Text="New campaign" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Margin="0,0,0,6">
        <RadioButton GroupName="adtarget" Content="A country" IsChecked="{Binding CountryTarget}" />
        <RadioButton GroupName="adtarget" Content="An airport" IsChecked="{Binding AirportTarget}" />
      </StackPanel>
      <TextBox Grid.Row="2" Text="{Binding Search}" Watermark="search (empty = the places you fly to)" Margin="0,0,0,6" />
      <ListBox Grid.Row="3" ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="4" Spacing="6" Margin="0,8,0,0">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding Sizes}" SelectedItem="{Binding Size}" MinWidth="110" />
          <TextBlock Text="for" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding MonthChoices}" SelectedItem="{Binding Months}" MinWidth="70" />
          <TextBlock Text="month(s)" VerticalAlignment="Center" />
          <Button Content="Start" Command="{Binding StartCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding CampaignText}" Opacity="0.8" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
