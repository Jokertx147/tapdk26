<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.RatingsView">
  <ScrollViewer Margin="0,10,0,0">
    <StackPanel Spacing="10" Margin="0,0,12,0">
      <TextBlock Text="{Binding Summary}" FontSize="20" FontWeight="Bold" />
      <TextBlock Text="{Binding Rank}" Opacity="0.85" />

      <ItemsControl ItemsSource="{Binding Ratings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#262626" CornerRadius="6" Padding="12" Margin="0,0,0,8">
              <Grid ColumnDefinitions="260,*" RowDefinitions="Auto,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ValueText}" FontSize="15" />
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding Value}" Height="8" Width="220" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding Change}" Opacity="0.7" />
                  <TextBlock Text="{Binding Heading}" Opacity="0.7" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="6">
                  <TextBlock Text="{Binding Reasons}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Tip}" TextWrapping="Wrap" Opacity="0.65" FontStyle="Italic" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding Effects}" TextWrapping="Wrap" Opacity="0.75" />

      <TextBlock Text="Compared with other airlines" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ItemsControl ItemsSource="{Binding Compare}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="50,300,60,*" Margin="0,2">
              <TextBlock Text="{Binding Rank}" Opacity="0.7" />
              <TextBlock Grid.Column="1" Text="{Binding Airline}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="2" Text="{Binding Overall}" FontWeight="SemiBold" />
              <TextBlock Grid.Column="3" Text="{Binding Detail}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Statistics" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <Grid ColumnDefinitions="200,120,120,*">
        <TextBlock Text="" />
        <TextBlock Grid.Column="1" Text="This year" FontWeight="SemiBold" />
        <TextBlock Grid.Column="2" Text="Last year" FontWeight="SemiBold" />
        <TextBlock Grid.Column="3" Text="Change" FontWeight="SemiBold" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Stats}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="200,120,120,*" Margin="0,2">
              <TextBlock Text="{Binding Name}" />
              <TextBlock Grid.Column="1" Text="{Binding ThisYear}" />
              <TextBlock Grid.Column="2" Text="{Binding LastYear}" />
              <TextBlock Grid.Column="3" Text="{Binding Change}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
