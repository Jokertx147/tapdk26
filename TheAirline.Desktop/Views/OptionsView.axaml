<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.OptionsView">
  <ScrollViewer Margin="0,10,0,0">
    <StackPanel Spacing="10" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Text="Save the game" FontSize="16" FontWeight="SemiBold" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBox Text="{Binding SaveName}" Width="300" Watermark="name of the save" />
        <Button Content="Save" Command="{Binding SaveCommand}" />
      </StackPanel>

      <Border IsVisible="{Binding HasPending}" Background="#3A2E1A" CornerRadius="4" Padding="10">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Yes" Command="{Binding ConfirmCommand}" />
            <Button Content="No" Command="{Binding CancelCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8" />

      <TextBlock Text="Saved games (pick one to save over it)" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ListBox ItemsSource="{Binding Saves}" SelectedItem="{Binding Selected}" MaxHeight="260">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="14" Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SavedText}" Opacity="0.7" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Content="Delete the selected save" Command="{Binding DeleteCommand}" HorizontalAlignment="Left" />

      <TextBlock Text="Date format" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <RadioButton GroupName="datefmt" Content="US (MM-DD-YYYY)" IsChecked="{Binding UseUsDate}" />
        <RadioButton GroupName="datefmt" Content="International (DD-MM-YYYY)" IsChecked="{Binding UseInternationalDate}" />
      </StackPanel>
      <TextBlock Text="{Binding DateExample}" Opacity="0.6" />

      <TextBlock Text="Distances and speeds" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <RadioButton GroupName="distfmt" Content="Kilometres (km, km/h, m)" IsChecked="{Binding UseKilometres}" />
        <RadioButton GroupName="distfmt" Content="Miles (mi, mph, ft)" IsChecked="{Binding UseMiles}" />
      </StackPanel>
      <TextBlock Text="{Binding DistanceExample}" Opacity="0.6" />

      <TextBlock Text="Leave" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="Main menu" Command="{Binding MainMenuCommand}" />
        <Button Content="Exit the game" Command="{Binding ExitCommand}" />
      </StackPanel>
      <CheckBox Content="Autosave when I leave the game" IsChecked="{Binding AutoSave}" />
      <TextBlock Text="{Binding LeaveText}" Opacity="0.6" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
