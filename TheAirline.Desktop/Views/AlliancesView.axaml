<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.AlliancesView">
  <Grid ColumnDefinitions="340,12,*" Margin="0,10,0,0">
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBlock Text="Alliances" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Alliances}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="2" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="2" Spacing="6" Margin="0,10,0,0">
        <TextBlock Text="Start an alliance" FontWeight="SemiBold" />
        <TextBox Text="{Binding NewName}" Watermark="name of the alliance" />
        <ComboBox ItemsSource="{Binding Headquarters}" SelectedItem="{Binding Headquarter}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Profile.Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Content="Create (headquarters at the airport above)" Command="{Binding CreateCommand}" />
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Column="2">
      <StackPanel Spacing="8" Margin="0,0,12,0">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Info}" Opacity="0.8" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasSelection}">
          <Button Content="Ask to join" Command="{Binding JoinCommand}" IsVisible="{Binding CanJoin}" />
          <Button Content="Leave alliance" Command="{Binding LeaveCommand}" IsVisible="{Binding IsMember}" />
        </StackPanel>

        <Border IsVisible="{Binding HasPending}" Background="#3A2E1A" CornerRadius="4" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Yes" Command="{Binding ConfirmCommand}" />
              <Button Content="No" Command="{Binding CancelCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="Members" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ItemsControl ItemsSource="{Binding Members}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Requests to join" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" IsVisible="{Binding HasRequests}" />
        <ItemsControl ItemsSource="{Binding Requests}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Accept" Command="{Binding AcceptCommand}" Margin="8,0,0,0" />
                <Button Grid.Column="2" Content="Decline" Command="{Binding DeclineCommand}" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding IsMember}" Spacing="6">
          <TextBlock Text="Invite an airline" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ComboBox ItemsSource="{Binding InviteCandidates}" SelectedItem="{Binding Invite}" MinWidth="280">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Profile.Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Invite" Command="{Binding InviteCommand}" />
          </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
