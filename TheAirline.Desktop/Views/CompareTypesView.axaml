<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.CompareTypesView">
  <Grid ColumnDefinitions="300,16,*" Margin="0,10,0,0">

    <!-- pick types -->
    <Grid RowDefinitions="Auto,*,Auto">
      <TextBox Text="{Binding Search}" Watermark="search aircraft type or maker" Margin="0,0,0,6" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" DoubleTapped="OnChoiceDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
        <Button Content="Add to comparison" Command="{Binding AddCommand}" />
        <Button Content="Clear" Command="{Binding ClearCommand}" />
      </StackPanel>
    </Grid>

    <!-- the comparison -->
    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto">
      <StackPanel Spacing="8" Margin="0,0,12,0">
        <TextBlock Text="Pick up to four types on the left (double-click adds one), or use Compare on the New aircraft page." Opacity="0.7" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Flight of" VerticalAlignment="Center" />
          <TextBox Text="{Binding Distance}" Width="80" />
          <TextBlock Text="km, or route" VerticalAlignment="Center" />
          <TextBox Text="{Binding Route}" Width="110" Watermark="ATL-LHR" />
        </StackPanel>
        <TextBlock Text="{Binding DistanceText}" Opacity="0.7" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasColumns}">
          <!-- row names -->
          <StackPanel Width="150" Margin="0,34,0,0">
            <ItemsControl ItemsSource="{Binding Labels}">
              <ItemsControl.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding}" Height="24" Opacity="0.7" /></DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <!-- one column per type -->
          <ItemsControl ItemsSource="{Binding Columns}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="12" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="#262626" CornerRadius="6" Padding="10,4" Width="200">
                  <StackPanel>
                    <Grid ColumnDefinitions="*,Auto" Height="30">
                      <TextBlock Text="{Binding Type.Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Content="x" Command="{Binding RemoveCommand}" Padding="6,0" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Values}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding}" Height="24" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding}" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
