<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.CompetitorsView">
  <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,*" Margin="0,10,0,0">
    <StackPanel Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Show" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding ShowChoices}" SelectedItem="{Binding Show}" MinWidth="160" />
        <ComboBox ItemsSource="{Binding FilterChoices}" SelectedItem="{Binding Filter}" MinWidth="180" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="Fares are economy fares (cargo: the rate per unit). Full is the share of seats filled last month, or this month so far." Opacity="0.6" TextWrapping="Wrap" />
    </StackPanel>

    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border IsVisible="{Binding HasBadge}" Background="{Binding IsWarning, Converter={x:Static v:CompetitorBadgeBrush.Instance}}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="White" />
              </Border>
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="{Binding Line1}" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Line2}" Opacity="0.65" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer Grid.Row="1" Grid.Column="2">
      <StackPanel Spacing="4" IsVisible="{Binding HasSelection}" Margin="0,0,12,0">
        <TextBlock Text="{Binding DetailTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <Button Content="Open my route" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpenRoute}" HorizontalAlignment="Left" />
        <ItemsControl ItemsSource="{Binding DetailLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
