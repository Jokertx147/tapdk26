<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.WorldMapView">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,6">
      <TextBlock Text="World map" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      <CheckBox Content="Routes" IsChecked="{Binding ShowRoutes}" />
      <CheckBox Content="Airports" IsChecked="{Binding ShowAirports}" />
      <CheckBox Content="Aircraft" IsChecked="{Binding ShowAircraft}" />
      <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" Opacity="0.7" />
    </StackPanel>
    <Border Grid.Row="1" BorderBrush="#555555" BorderThickness="1" MinHeight="300">
      <v:WorldMapControl DataContext="{Binding}" />
    </Border>
    <StackPanel Grid.Row="2" Margin="0,6,0,0" Spacing="2">
      <TextBlock Text="{Binding SelectedText}" TextWrapping="Wrap" />
      <TextBlock Text="Drag to move, scroll to zoom. Yellow arrows are aircraft in the air, grey dots are aircraft on the ground, red dots are hubs. Orange dashed lines are cargo routes." Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
