<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.WorldMapView">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,6">
      <TextBlock Text="World map" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      <CheckBox Content="Routes" IsChecked="{Binding ShowRoutes}" />
      <CheckBox Content="Airports" IsChecked="{Binding ShowAirports}" />
      <CheckBox Content="Aircraft" IsChecked="{Binding ShowAircraft}" />
      <CheckBox Content="Animate" IsChecked="{Binding Animate}" ToolTip.Tip="Aircraft glide along their routes with a trail behind them, and white dashes flow along each route in the direction its aircraft are flying. Turn off on a slow computer." />
      <TextBlock Text="{Binding Caption}" VerticalAlignment="Center" Opacity="0.7" />
      <Button Content="+" Click="ZoomIn" ToolTip.Tip="Zoom in" MinWidth="32" />
      <Button Content="-" Click="ZoomOut" ToolTip.Tip="Zoom out" MinWidth="32" />
      <Button Content="Fit network" Click="FitNetwork" ToolTip.Tip="Show the whole airline network" />
      <ComboBox ItemsSource="{Binding AircraftChoices}" SelectedItem="{Binding PickedAircraft}" PlaceholderText="Pick an aircraft" MinWidth="200" MaxDropDownHeight="420"
                ToolTip.Tip="One of your aircraft: selected and followed on the map" />
      <ToggleButton Content="Follow" IsChecked="{Binding Follow}" IsEnabled="{Binding HasSelection}"
                    ToolTip.Tip="Keep the selected aircraft in the middle of the map as it flies. Dragging the map stops it." />
    </StackPanel>
    <StackPanel Grid.Row="1" Spacing="4" Margin="0,0,0,6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Rivals" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding RivalChoices}" SelectedItem="{Binding SelectedRival}" MinWidth="320" MaxDropDownHeight="420"
                  ToolTip.Tip="Show a rival airline's routes and aircraft, the airlines on your routes, or everyone flying from one of your airports, each in its own colour." />
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Legend}" IsVisible="{Binding HasLegend}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,14,2">
              <Border Width="14" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{Binding Color, Converter={x:Static v:HexBrush.Instance}}" />
              <TextBlock Text="{Binding Text}" FontSize="12" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
      <Border BorderBrush="#555555" BorderThickness="1" MinHeight="300">
        <v:WorldMapControl x:Name="MapControl" DataContext="{Binding}" />
      </Border>

      <!-- the selected aircraft's flights today -->
      <Border Grid.Column="1" Width="360" Margin="8,0,0,0" IsVisible="{Binding HasSelection}" BorderBrush="#555555" BorderThickness="1" Padding="8">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,6">
            <TextBlock Text="Flight board" FontSize="15" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BoardTitle}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BoardSummary}" TextWrapping="Wrap" Opacity="0.75" FontSize="12" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Top" Text="No flights today." Opacity="0.6" IsVisible="{Binding !HasBoardFlights}" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding FlightBoard}">
              <ItemsControl.Styles>
                <Style Selector="Border.row">
                  <Setter Property="Padding" Value="6,4" />
                  <Setter Property="Margin" Value="0,0,0,3" />
                  <Setter Property="CornerRadius" Value="4" />
                  <Setter Property="Background" Value="#14808080" />
                </Style>
                <Style Selector="Border.row.airborne">
                  <Setter Property="Background" Value="#33E8A800" />
                </Style>
                <Style Selector="Border.row.cancelled">
                  <Setter Property="Background" Value="#33A23B3B" />
                </Style>
                <Style Selector="Border.row.done">
                  <Setter Property="Opacity" Value="0.75" />
                </Style>
                <Style Selector="TextBlock.loss">
                  <Setter Property="Foreground" Value="#C24A4A" />
                </Style>
              </ItemsControl.Styles>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="row" Classes.airborne="{Binding IsAirborne}" Classes.cancelled="{Binding IsCancelled}" Classes.done="{Binding IsDone}">
                    <StackPanel Spacing="1">
                      <Grid ColumnDefinitions="48,64,*,52">
                        <TextBlock Text="{Binding Departs}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding Flight}" />
                        <TextBlock Grid.Column="2" Text="{Binding Route}" />
                        <TextBlock Grid.Column="3" Text="{Binding Arrives}" HorizontalAlignment="Right" Opacity="0.8" />
                      </Grid>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Result}" FontSize="12" IsVisible="{Binding HasResult}" Classes.loss="{Binding IsLoss}" />
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <StackPanel Grid.Row="3" Margin="0,6,0,0" Spacing="2">
      <TextBlock Text="{Binding SelectedText}" TextWrapping="Wrap" />
      <TextBlock Text="Drag to move (arrow keys work too; either stops following), scroll or double-click to zoom, + and - keys or the buttons also zoom, Home fits the network. Yellow arrows are aircraft in the air (they glide with a trail while the game runs, and white dashes flow along their routes the way they fly; click one to see its whole flight), grey dots are aircraft on the ground, red dots are hubs. Orange dashed lines are cargo routes. Rivals you choose to show are drawn in their own colours (their airports as small white dots)." Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>
  </Grid>
</UserControl>
