<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.AirlineView">
  <Grid RowDefinitions="Auto,*" Margin="16">
    <!-- top bar: airline, date, money, controls -->
    <Border Background="#262626" CornerRadius="6" Padding="14" Margin="0,0,0,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding AirlineName}" FontSize="22" FontWeight="Bold" />
          <StackPanel Orientation="Horizontal" Spacing="24">
            <TextBlock Text="{Binding Date}" FontSize="16" />
            <TextBlock Text="{Binding Money}" FontSize="16" />
            <TextBlock Text="{Binding Status}" Opacity="0.7" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="{Binding PauseText}" Command="{Binding TogglePauseCommand}" MinWidth="70" HorizontalContentAlignment="Center" />
          <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}" MinWidth="110" />
          <Button Content="Save" Command="{Binding SaveCommand}" />
          <Button Content="Main menu" Command="{Binding MainMenuCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Classes="main">
      <TabControl.Styles>
        <!-- the sub tabs under each main tab are smaller -->
        <Style Selector="TabControl.sub TabItem">
          <Setter Property="FontSize" Value="13" />
          <Setter Property="MinHeight" Value="28" />
          <Setter Property="Padding" Value="10,2" />
        </Style>
      </TabControl.Styles>

      <!-- AIRLINE -->
      <TabItem Header="Airline">
        <TabControl Classes="sub">
          <TabItem Header="Overview">
            <StackPanel Margin="0,14,0,0" Spacing="8">
              <TextBlock Text="{Binding AirlineName}" FontSize="20" FontWeight="Bold" />
              <TextBlock Text="{Binding Summary}" FontSize="15" />
              <TextBlock Text="Buy or lease aircraft in the Aircraft market tab, then create routes under Routes." Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
          </TabItem>
          <TabItem Header="Aircraft market">
            <v:MarketView DataContext="{Binding Market}" />
          </TabItem>
          <TabItem Header="Pilots">
            <v:PilotsView DataContext="{Binding Pilots}" />
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- ROUTES -->
      <TabItem Header="Routes">
        <TabControl Classes="sub">
          <TabItem Header="My routes">
            <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
              <TextBlock Text="Routes" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ListBox Grid.Row="1" ItemsSource="{Binding Routes}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" MinWidth="120" />
                      <TextBlock Text="{Binding Distance}" Opacity="0.7" MinWidth="90" />
                      <TextBlock Text="{Binding Balance}" Opacity="0.7" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <TabItem Header="Create route">
            <v:AirportsView DataContext="{Binding Airports}" />
          </TabItem>
        </TabControl>
      </TabItem>

      <!-- FLIGHTS -->
      <TabItem Header="Flights">
        <TabControl Classes="sub">
          <TabItem Header="Fleet">
            <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
              <TextBlock Text="Fleet" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ListBox Grid.Row="1" ItemsSource="{Binding Fleet}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="2">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Opacity="0.7">
                          <Run Text="{Binding Type}" /><Run Text="  |  " /><Run Text="{Binding Status}" /><Run Text="  |  " /><Run Text="{Binding Homebase}" /><Run Text="  |  " /><Run Text="{Binding Crew}" /><Run Text="  |  " /><Run Text="{Binding Routes}" /><Run Text=" route(s)" />
                        </TextBlock>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" />
                        <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
          <TabItem Header="Timetable">
            <Grid RowDefinitions="Auto,*" Margin="0,10,0,0">
              <TextBlock Text="Weekly flights" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
              <ListBox Grid.Row="1" ItemsSource="{Binding Flights}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="2">
                      <TextBlock Text="{Binding When}" MinWidth="130" />
                      <TextBlock Text="{Binding Flight}" FontWeight="SemiBold" MinWidth="80" />
                      <TextBlock Text="{Binding Route}" MinWidth="100" />
                      <TextBlock Text="{Binding Aircraft}" Opacity="0.7" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </TabItem>
        </TabControl>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
