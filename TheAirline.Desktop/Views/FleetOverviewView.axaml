<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.FleetOverviewView">
  <Grid RowDefinitions="Auto,*,Auto" Margin="0,10,0,0">
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Text="Fleet" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBox Text="{Binding Search}" Watermark="search name, type or airport" Width="230" />
      <TextBlock Text="Sort by" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding SortBy}" MinWidth="130" />
      <CheckBox Content="Auto ferry" IsChecked="{Binding AutoFerry}" ToolTip.Tip="An idle aircraft scheduled to fly from another airport ferries there first (costs fuel, takes time)" />
      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Opacity="0.7" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,10,360">
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2">
              <StackPanel Orientation="Horizontal">
                <Border IsVisible="{Binding IsIdle}" Background="#C26A00" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="IDLE" FontSize="11" FontWeight="Bold" Foreground="White" /></Border>
                          <Border IsVisible="{Binding IsOnOrder}" Background="#1F6FB5" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="&#x2708; ON ORDER" FontSize="11" FontWeight="Bold" Foreground="White" /></Border>
                <TextBlock FontWeight="SemiBold">
                  <Run Text="{Binding Name}" /><Run Text="   " /><Run Text="{Binding Type}" />
                </TextBlock>
              </StackPanel>
              <TextBlock Opacity="0.75">
                <Run Text="{Binding Cabin}" /><Run Text="  |  " /><Run Text="{Binding Status}" /><Run Text="  |  " /><Run Text="{Binding Homebase}" /><Run Text="  |  " /><Run Text="{Binding Routes}" /><Run Text=" route(s)" />
              </TextBlock>
              <TextBlock Opacity="0.75">
                <Run Text="{Binding Ownership}" /><Run Text="  |  age " /><Run Text="{Binding Age}" /><Run Text="  |  condition " /><Run Text="{Binding Condition}" /><Run Text="  |  pilots " /><Run Text="{Binding Crew}" /><Run Text="  |  value " /><Run Text="{Binding Value}" />
              </TextBlock>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ScrollViewer Grid.Column="2">
        <StackPanel Spacing="8">
          <TextBlock Text="No aircraft yet. Order or buy one under Airliners." IsVisible="{Binding !HasRows}" Opacity="0.6" TextWrapping="Wrap" />
          <TextBlock Text="Select an aircraft to see its details." IsVisible="{Binding !HasSelection}" Opacity="0.6" />
          <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
            <WrapPanel>
              <Button Content="Start" Command="{Binding StartCommand}" IsVisible="{Binding CanStart}" Margin="0,0,8,0" />
              <Button Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding CanStop}" Margin="0,0,8,0" />
              <Button Content="Schedule..." Command="{Binding ScheduleCommand}" IsVisible="{Binding CanSchedule}" Margin="0,0,8,0" />
              <Button Content="Edit cabin" Command="{Binding CabinCommand}" IsVisible="{Binding CanCabin}" Margin="0,0,8,0" />
              <Button Content="{Binding SellText}" Command="{Binding SellCommand}" />
            </WrapPanel>
            <Border Background="#262626" CornerRadius="6" Padding="10">
              <StackPanel Spacing="6">
                <TextBlock Text="Ferry flight (empty, to another of your airports)" FontWeight="SemiBold" TextWrapping="Wrap" />
                <ComboBox ItemsSource="{Binding FerryTargets}" SelectedItem="{Binding FerryTarget}" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding FerryHint}" TextWrapping="Wrap" Opacity="0.75" />
                <Button Content="Ferry there" Command="{Binding FerryCommand}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Details}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Routes" FontWeight="SemiBold" Margin="0,6,0,0" />
            <ItemsControl ItemsSource="{Binding RouteLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="0,1">
                    <Run Text="{Binding Name}" /><Run Text="  |  " /><Run Text="{Binding Balance}" /><Run Text="  |  " /><Run Text="{Binding Filling}" />
                  </TextBlock>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
      <Border IsVisible="{Binding HasPending}" Background="#262626" CornerRadius="6" Padding="10">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Yes" Command="{Binding ConfirmCommand}" />
            <Button Content="No" Command="{Binding CancelCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.85" />
    </StackPanel>
  </Grid>
</UserControl>
