<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.LoansView">
  <ScrollViewer Margin="0,10,0,0">
    <StackPanel Spacing="10" MaxWidth="760" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />

      <TextBlock Text="Take a loan" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBox Text="{Binding AmountText}" Width="170" Watermark="amount, e.g. 10000000" />
        <ComboBox ItemsSource="{Binding YearChoices}" SelectedItem="{Binding Years}" MinWidth="70" />
        <TextBlock Text="years" VerticalAlignment="Center" />
        <Button Content="Apply for loan" Command="{Binding TakeLoanCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding OfferText}" Opacity="0.8" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

      <TextBlock Text="Your loans" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ItemsControl ItemsSource="{Binding Loans}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#262626" CornerRadius="6" Padding="10" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Opacity="0.7" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBox Text="{Binding PayText}" Width="130" Watermark="amount" />
                  <Button Content="Pay" Command="{Binding PayCommand}" />
                  <Button Content="Pay off" Command="{Binding PayOffCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
