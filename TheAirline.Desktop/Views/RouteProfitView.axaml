<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.RouteProfitView">
  <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,*" Margin="0,10,0,0">
    <StackPanel Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Show" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding ShowChoices}" SelectedItem="{Binding Show}" MinWidth="160" />
        <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="12,0,0,0" />
        <ComboBox ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SortBy}" MinWidth="200" />
      </StackPanel>
      <TextBlock Text="A route's own income and costs (tickets, in-flight sales, fuel and handling, crew, maintenance, fees), before what its aircraft cost to own or lease." Opacity="0.6" TextWrapping="Wrap" />
    </StackPanel>

    <!-- the routes -->
    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Border IsVisible="{Binding IsLoss}" Background="#A23B3B" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                <TextBlock Text="LOSS" FontSize="11" FontWeight="Bold" Foreground="White" />
              </Border>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Profit}" Opacity="0.85" />
            </StackPanel>
            <TextBlock Text="{Binding Numbers}" Opacity="0.7" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Advice}" Opacity="0.6" FontStyle="Italic" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- one route, month by month -->
    <ScrollViewer Grid.Row="1" Grid.Column="2">
      <StackPanel Spacing="6" IsVisible="{Binding HasSelection}" Margin="0,0,12,0">
        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontWeight="SemiBold" />
        <Button Content="Open the route" Command="{Binding OpenCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="Each month" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
        <ItemsControl ItemsSource="{Binding Months}">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Where the money went" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
        <ItemsControl ItemsSource="{Binding Breakdown}">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
