<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.AirportManagerView">
  <Grid ColumnDefinitions="300,12,*" RowDefinitions="*,Auto" Margin="0,10,0,0">

    <!-- airport picker -->
    <Grid RowDefinitions="Auto,*">
      <TextBox Text="{Binding Search}" Watermark="search airport, code or country (empty = your airports)" Margin="0,0,0,6" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Airports}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <ScrollViewer Grid.Column="2">
      <StackPanel Spacing="10" Margin="0,0,12,0">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Info}" Opacity="0.8" TextWrapping="Wrap" />
        <TextBlock Text="{Binding GateSummary}" />

        <TextBlock Text="Your contracts" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ListBox ItemsSource="{Binding Contracts}" SelectedItem="{Binding SelectedContract}" MaxHeight="130">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Button Content="End selected contract" Command="{Binding EndContractCommand}" IsVisible="{Binding NotConfirmEnd}" HorizontalAlignment="Left" />
        <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding ConfirmEnd}">
          <TextBlock Text="{Binding EndText}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
          <Button Content="Yes, end it" Command="{Binding ConfirmEndCommand}" />
          <Button Content="Cancel" Command="{Binding CancelEndCommand}" />
        </StackPanel>

        <TextBlock Text="Lease gates" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ComboBox ItemsSource="{Binding ContractTypes}" SelectedItem="{Binding ContractType}" MinWidth="170" />
          <ComboBox ItemsSource="{Binding GateChoices}" SelectedItem="{Binding Gates}" MinWidth="70" />
          <TextBlock Text="gate(s)" VerticalAlignment="Center" />
          <Button Content="Lease" Command="{Binding LeaseCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding PriceText}" Opacity="0.8" TextWrapping="Wrap" />

        <TextBlock Text="Terminals" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ItemsControl ItemsSource="{Binding Terminals}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Buy" Command="{Binding BuyCommand}" IsVisible="{Binding CanBuy}" Margin="8,0,0,0" />
                <Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding SellCommand}" IsVisible="{Binding CanSell}" Margin="8,0,0,0" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="Build a terminal" FontWeight="SemiBold" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBox Text="{Binding TerminalName}" Width="160" Watermark="name" />
          <ComboBox ItemsSource="{Binding TerminalGateChoices}" SelectedItem="{Binding TerminalGates}" MinWidth="70" />
          <TextBlock Text="gates" VerticalAlignment="Center" />
          <CheckBox Content="Cargo" IsChecked="{Binding TerminalCargo}" />
          <Button Content="Build" Command="{Binding BuildTerminalCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding TerminalPriceText}" Opacity="0.8" TextWrapping="Wrap" />

        <Border IsVisible="{Binding HasPending}" Background="#3A2E1A" CornerRadius="4" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Yes" Command="{Binding ConfirmPendingCommand}" />
              <Button Content="No" Command="{Binding CancelPendingCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="Facilities (needs a contract here)" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ItemsControl ItemsSource="{Binding Facilities}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Opacity="0.7" TextWrapping="Wrap">
                    <Run Text="now: " /><Run Text="{Binding Current}" /><Run Text="   next: " /><Run Text="{Binding Next}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Building}" Opacity="0.7" />
                </StackPanel>
                <Button Grid.Column="1" Content="Build" Command="{Binding BuyCommand}" IsVisible="{Binding CanBuy}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
  </Grid>
</UserControl>
