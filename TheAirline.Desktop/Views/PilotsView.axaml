<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.PilotsView">
  <ScrollViewer>
  <Grid RowDefinitions="Auto,320,Auto,Auto,Auto,Auto" ColumnDefinitions="*,12,*" Margin="0,10,0,0">
    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Text="Pilots for" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" MinWidth="320" />
      <Button Content="Hire full crew for this aircraft" Command="{Binding HireCrewCommand}" />
      <Button Content="Put idle pilots on aircraft" Command="{Binding AssignIdleCommand}" />
    </StackPanel>

    <Grid Grid.Row="1" RowDefinitions="Auto,*">
      <TextBlock Text="Pilots for hire" FontWeight="SemiBold" Margin="0,0,0,6" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Available}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Details}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*">
      <TextBlock Text="Your pilots" FontWeight="SemiBold" Margin="0,0,0,6" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Hired}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2">
              <StackPanel Orientation="Horizontal">
                <Border IsVisible="{Binding IsIdle}" Background="#C26A00" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="NO AIRCRAFT" FontSize="11" FontWeight="Bold" Foreground="White" /></Border>
                <Border IsVisible="{Binding IsTraining}" Background="#1F6FB5" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"><TextBlock Text="TRAINING" FontSize="11" FontWeight="Bold" Foreground="White" /></Border>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              </StackPanel>
              <TextBlock Text="{Binding Assignment}" Opacity="0.7" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border IsVisible="{Binding IsUnhappy}" Background="#B03030" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"><TextBlock Text="UNHAPPY" FontSize="11" FontWeight="Bold" Foreground="White" /></Border>
                <TextBlock Text="{Binding Mood}" Opacity="0.7" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Hire selected pilot" Command="{Binding HireCommand}" />
    </Grid>

    <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#262626" CornerRadius="6" Padding="12" Margin="0,10,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Pay and morale" FontWeight="SemiBold" />
        <TextBlock Text="{Binding MoraleText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Pay level" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding PayLevels}" SelectedItem="{Binding PayLevel}" MinWidth="160" />
          <Button Content="Pay a bonus to all pilots" Command="{Binding BonusCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding PayText}" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="4" Grid.ColumnSpan="3" Background="#262626" CornerRadius="6" Padding="12" Margin="0,10,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Assign pilots to aircraft" FontWeight="SemiBold" />
        <CheckBox Content="Assign pilots automatically (new graduates, pilots back from training, pilots without an aircraft)" IsChecked="{Binding AutoAssign}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Pilot" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding AssignPilots}" SelectedItem="{Binding AssignPilot}" MinWidth="320" />
          <TextBlock Text="Aircraft" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding AssignTargets}" SelectedItem="{Binding AssignTarget}" MinWidth="320" />
          <Button Content="Assign" Command="{Binding AssignCommand}" />
          <Button Content="Take off aircraft" Command="{Binding UnassignCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding AssignHint}" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Grid.Row="5" Grid.ColumnSpan="3" Background="#262626" CornerRadius="6" Padding="12" Margin="0,10,0,0">
      <StackPanel Spacing="8">
        <TextBlock Text="Train a pilot for another aircraft family" FontWeight="SemiBold" />
        <Border IsVisible="{Binding HasPending}" Background="#3a3320" CornerRadius="6" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Yes" Command="{Binding ConfirmCommand}" />
              <Button Content="No" Command="{Binding CancelCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Pilot" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding TrainPilots}" SelectedItem="{Binding TrainPilot}" MinWidth="320" />
          <TextBlock Text="Train for" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding TrainFamilies}" SelectedItem="{Binding TrainFamily}" MinWidth="320" />
          <Button Content="Train pilot" Command="{Binding TrainCommand}" />
        </StackPanel>
        <CheckBox Content="Also pilots who fly an aircraft (a substitute pilot is paid)" IsChecked="{Binding IncludeAssigned}" />
        <TextBlock Text="{Binding TrainHint}" Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
  </ScrollViewer>
</UserControl>
