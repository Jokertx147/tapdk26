<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.PilotsView">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,12,*" Margin="0,10,0,0">
    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Text="Pilots for" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding Target}" MinWidth="320" />
      <Button Content="Hire full crew for this aircraft" Command="{Binding HireCrewCommand}" />
      <Button Content="Put idle pilots on aircraft" Command="{Binding AssignIdleCommand}" />
    </StackPanel>

    <Grid Grid.Row="1" RowDefinitions="Auto,*">
      <TextBlock Text="Pilots for hire" FontWeight="SemiBold" Margin="0,0,0,6" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Available}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Details}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid Grid.Row="1" Grid.Column="2" RowDefinitions="Auto,*">
      <TextBlock Text="Your pilots" FontWeight="SemiBold" Margin="0,0,0,6" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Hired}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Assignment}" Opacity="0.7" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" />
      <Button Grid.Column="1" Content="Hire selected pilot" Command="{Binding HireCommand}" />
    </Grid>
  </Grid>
</UserControl>
