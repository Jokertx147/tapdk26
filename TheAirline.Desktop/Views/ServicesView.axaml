<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.ServicesView">
  <ScrollViewer Margin="0,10,0,0">
    <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
      <Border IsVisible="{Binding HasPending}" Background="#3a3320" CornerRadius="6" Padding="10">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Yes" Command="{Binding ConfirmCommand}" />
            <Button Content="No" Command="{Binding CancelCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

      <TextBlock Text="Airline facilities" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ItemsControl ItemsSource="{Binding Facilities}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#262626" CornerRadius="6" Padding="10" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding Command}" VerticalAlignment="Center" MinWidth="70" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Pilot training" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ComboBox ItemsSource="{Binding TrainingChoices}" SelectedItem="{Binding SelectedTraining}" MinWidth="240" />
        <Button Content="Buy training facility" Command="{Binding BuyTrainingCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding TrainingText}" Opacity="0.7" TextWrapping="Wrap" />
      <TextBlock Text="Training facilities you own are listed above with the other facilities, marked (yours)." Opacity="0.6" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
