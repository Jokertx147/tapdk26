<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.GateContractsView">
  <Grid ColumnDefinitions="*,12,380" RowDefinitions="Auto,*" Margin="0,10,0,0">

    <StackPanel Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,8">
      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
      <WrapPanel>
        <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" MinWidth="190" Margin="0,0,14,0" />
        <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" MinWidth="150" Margin="0,0,14,0" />
        <Button Content="Renew all by themselves" Command="{Binding RenewAllCommand}" />
      </WrapPanel>
    </StackPanel>

    <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2" Spacing="1">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Numbers}" Opacity="0.8" />
            <TextBlock Text="{Binding Expiry}" Opacity="0.65" />
            <TextBlock Text="{Binding Warning}" IsVisible="{Binding HasWarning}" Foreground="#E0A040" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer Grid.Row="1" Grid.Column="2">
      <StackPanel Spacing="8" IsVisible="{Binding HasSelection}" Margin="0,0,8,0">
        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
        <CheckBox Content="Renew by itself when it ends" IsChecked="{Binding AutoRenew}" />
        <Button Content="Show this airport" Command="{Binding OpenAirportCommand}" />

        <Border IsVisible="{Binding HasPending}" Background="#3a3320" CornerRadius="6" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Yes" Command="{Binding ConfirmCommand}" />
              <Button Content="No" Command="{Binding CancelCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="Extend" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="by" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding YearChoices}" SelectedItem="{Binding Years}" MinWidth="70" />
          <TextBlock Text="year(s)" VerticalAlignment="Center" />
          <Button Content="Extend" Command="{Binding ExtendCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding ExtendText}" Opacity="0.75" TextWrapping="Wrap" />

        <TextBlock Text="Gates" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox ItemsSource="{Binding GateChoices}" SelectedItem="{Binding Gates}" MinWidth="70" />
          <TextBlock Text="gate(s)" VerticalAlignment="Center" />
          <Button Content="Add" Command="{Binding AddGatesCommand}" />
          <Button Content="Give back" Command="{Binding RemoveGatesCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding GatesText}" Opacity="0.75" TextWrapping="Wrap" />

        <Button Content="End this contract..." Command="{Binding EndCommand}" Margin="0,10,0,0" />
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,0,8,0" />
  </Grid>
</UserControl>
