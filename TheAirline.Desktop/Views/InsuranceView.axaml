<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.InsuranceView">
  <ScrollViewer Margin="0,10,0,0">
    <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
      <Border IsVisible="{Binding HasPending}" Background="#3a3320" CornerRadius="6" Padding="10">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Yes" Command="{Binding ConfirmCommand}" />
            <Button Content="No" Command="{Binding CancelPendingCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

      <TextBlock Text="Your policies" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ItemsControl ItemsSource="{Binding Policies}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#262626" CornerRadius="6" Padding="10" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Detail}" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Cancel policy" Command="{Binding CancelCommand}" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="Buy a policy" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding Type}" MinWidth="190" />
        <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" MinWidth="110" />
        <ComboBox ItemsSource="{Binding Terms}" SelectedItem="{Binding PaymentTerm}" MinWidth="150" />
        <ComboBox ItemsSource="{Binding YearChoices}" SelectedItem="{Binding Years}" MinWidth="70" />
        <TextBlock Text="years" VerticalAlignment="Center" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBox Text="{Binding AmountText}" Width="170" Watermark="limit per aircraft" />
        <Button Content="Buy policy" Command="{Binding BuyCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding CoverText}" Opacity="0.8" TextWrapping="Wrap" />
      <TextBlock Text="{Binding QuoteText}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
