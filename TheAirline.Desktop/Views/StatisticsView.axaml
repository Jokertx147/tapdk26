<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.StatisticsView">
  <ScrollViewer Margin="0,10,0,0">
    <StackPanel Spacing="10" Margin="0,0,12,12">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ComboBox ItemsSource="{Binding FigureChoices}" SelectedItem="{Binding Figure}" MinWidth="170" />
        <ComboBox ItemsSource="{Binding PeriodChoices}" SelectedItem="{Binding Period}" MinWidth="120" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Summary}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />

      <!-- the airlines on the chart: you and your closest rivals, in the map's colours -->
      <ItemsControl ItemsSource="{Binding Airlines}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <CheckBox IsChecked="{Binding Shown}" Margin="0,0,14,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Width="14" Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{Binding Color, Converter={x:Static v:HexBrush.Instance}}" />
                <TextBlock Text="{Binding Name}" />
              </StackPanel>
            </CheckBox>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <v:LineChart Data="{Binding Chart}" Height="300" />
      <TextBlock Text="Point at the chart for a period's figures. * is the month still running; a gap is a figure not known (a month before the game recorded it, or the cash of a month not ended)." Opacity="0.55" FontSize="12" TextWrapping="Wrap" />

      <Grid ColumnDefinitions="*,16,*">
        <!-- the chart's figures as a table -->
        <StackPanel Spacing="4">
          <TextBlock Text="The figures" FontSize="16" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="" Width="90" />
            <ItemsControl ItemsSource="{Binding TableHeader}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Text}" Width="110" TextAlignment="Right" FontWeight="SemiBold"
                             Foreground="{Binding Color, Converter={x:Static v:HexBrush.Instance}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Table}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,1">
                  <TextBlock Text="{Binding Period}" Width="90" Opacity="0.75" />
                  <ItemsControl ItemsSource="{Binding Cells}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding Text}" Width="110" TextAlignment="Right" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{Binding AirportsTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0" />
          <TextBlock Text="No flights of yours have landed this year yet." Opacity="0.7" IsVisible="{Binding !HasAirports}" />
          <Grid ColumnDefinitions="*,80,100,100,60,120" IsVisible="{Binding HasAirports}">
            <TextBlock Text="Airport" Opacity="0.65" />
            <TextBlock Grid.Column="1" Text="Arrivals" Opacity="0.65" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Text="Passengers" Opacity="0.65" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Last year" Opacity="0.65" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Text="" />
            <TextBlock Grid.Column="5" Text="Your share" Opacity="0.65" HorizontalAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding AirportRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,80,100,100,60,120" Margin="0,1">
                  <TextBlock Text="{Binding Airport}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding Arrivals}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="2" Text="{Binding Passengers}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{Binding LastYear}" HorizontalAlignment="Right" Opacity="0.7" />
                  <TextBlock Grid.Column="4" Text="{Binding Change}" HorizontalAlignment="Right"
                             Foreground="{Binding IsDown, Converter={x:Static v:ReportWarningBrush.Instance}}" />
                  <TextBlock Grid.Column="5" Text="{Binding Share}" HorizontalAlignment="Right" Opacity="0.75" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- every airline's year so far -->
        <StackPanel Grid.Column="2" Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="{Binding LeagueTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="by" VerticalAlignment="Center" Opacity="0.7" />
            <ComboBox ItemsSource="{Binding LeagueSortChoices}" SelectedItem="{Binding LeagueSort}" MinWidth="150" />
          </StackPanel>
          <Grid ColumnDefinitions="30,*,90,70,55,55,110,45">
            <TextBlock Text="" />
            <TextBlock Grid.Column="1" Text="Airline" Opacity="0.65" />
            <TextBlock Grid.Column="2" Text="Passengers" Opacity="0.65" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Text="Flights" Opacity="0.65" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="4" Text="Full" Opacity="0.65" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="5" Text="On time" Opacity="0.65" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="6" Text="Result" Opacity="0.65" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="7" Text="Fleet" Opacity="0.65" HorizontalAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding League}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="30,*,90,70,55,55,110,45" Margin="0,1">
                  <TextBlock Text="{Binding Rank}" Opacity="0.6" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                             FontWeight="{Binding IsMine, Converter={x:Static v:StatisticsBold.Instance}}" />
                  <TextBlock Grid.Column="2" Text="{Binding Passengers}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="3" Text="{Binding Flights}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="4" Text="{Binding Load}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="5" Text="{Binding OnTime}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="6" Text="{Binding Result}" HorizontalAlignment="Right" />
                  <TextBlock Grid.Column="7" Text="{Binding Fleet}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Flights, passengers and on time come from the game's statistics; the result is income less operating costs (aircraft bought and loans left out)." Opacity="0.55" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
