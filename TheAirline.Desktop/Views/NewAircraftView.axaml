<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.NewAircraftView">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Text="Order new aircraft" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBox Text="{Binding Filter}" Watermark="filter by type or manufacturer" Width="260" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="230,10,*">
      <ListBox ItemsSource="{Binding Manufacturers}" SelectedItem="{Binding Manufacturer}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" Margin="2" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ListBox Grid.Column="2" ItemsSource="{Binding Types}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Details}" Opacity="0.7" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="8">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Amount" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding Amount}" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="110" />
        <TextBlock Text="Home airport" VerticalAlignment="Center" Margin="10,0,0,0" />
        <ComboBox ItemsSource="{Binding Homebases}" SelectedItem="{Binding Homebase}" MinWidth="240">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Profile.Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Engine" VerticalAlignment="Center" Margin="10,0,0,0" />
        <ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding Engine}" MinWidth="220">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="16">
        <CheckBox IsChecked="{Binding DownPayment}" Content="Down payment (pay the rest on delivery)" />
        <CheckBox IsChecked="{Binding TerminateContract}" IsVisible="{Binding HasContractWarning}" Content="End my manufacturer contract" />
      </StackPanel>
      <TextBlock Text="{Binding ContractWarning}" IsVisible="{Binding HasContractWarning}" TextWrapping="Wrap" Foreground="OrangeRed" />

      <Expander IsVisible="{Binding HasCabin}" HorizontalAlignment="Stretch" Header="Cabin layout">
        <StackPanel Spacing="6" Margin="0,6,0,0" DataContext="{Binding Cabin}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Start from" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding Preset}" MinWidth="260" />
            <Button Content="+ Add class" Command="{Binding AddCommand}" />
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Opacity="0.8" />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding Classes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="0,0,0,1" BorderBrush="#33808080" Padding="0,6">
                  <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="80" VerticalAlignment="Center" />
                      <NumericUpDown Value="{Binding Seats}" Minimum="1" Maximum="{Binding MaxSeats}" Increment="1"
                                     FormatString="0" Width="110" IsEnabled="{Binding CanEditSeats}" />
                      <TextBlock Text="{Binding Info}" Opacity="0.7" VerticalAlignment="Center" />
                      <Button Content="Remove" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <ComboBox ItemsSource="{Binding Seat.Choices}" SelectedItem="{Binding Seat.Selected}" MinWidth="250" />
                      <ComboBox ItemsSource="{Binding Audio.Choices}" SelectedItem="{Binding Audio.Selected}" MinWidth="250" />
                      <ComboBox ItemsSource="{Binding Video.Choices}" SelectedItem="{Binding Video.Selected}" MinWidth="250" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </StackPanel>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
      <StackPanel>
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.8" />
      </StackPanel>
      <Button Grid.Column="1" Content="Order" Command="{Binding OrderCommand}" MinWidth="100" HorizontalContentAlignment="Center" />
    </Grid>
  </Grid>
</UserControl>
