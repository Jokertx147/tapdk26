<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.SharesView">
  <Grid ColumnDefinitions="*,16,*" Margin="0,10,0,0">

    <!-- your airline and your shares -->
    <ScrollViewer>
      <StackPanel Spacing="8" Margin="0,0,8,0">
        <Border Background="#262626" CornerRadius="6" Padding="12">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding MyText}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Issue" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Counts}" SelectedItem="{Binding IssueCount}" MinWidth="90" />
              <TextBlock Text="new shares" VerticalAlignment="Center" />
              <Button Content="Issue" Command="{Binding IssueCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding IssueText}" Opacity="0.75" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Buy back" VerticalAlignment="Center" />
              <ComboBox ItemsSource="{Binding Counts}" SelectedItem="{Binding BuybackCount}" MinWidth="90" />
              <TextBlock Text="shares" VerticalAlignment="Center" />
              <Button Content="Buy back" Command="{Binding BuyBackCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding BuybackText}" Opacity="0.75" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding HasPending}" Background="#3a3320" CornerRadius="6" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Yes" Command="{Binding ConfirmCommand}" />
              <Button Content="No" Command="{Binding CancelCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

        <TextBlock Text="Your shares in other airlines" FontSize="16" FontWeight="SemiBold" Margin="0,6,0,0" />
        <TextBlock Text="{Binding PortfolioText}" Opacity="0.8" TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding PortfolioRows}" SelectedItem="{Binding SelectedHolding}" MaxHeight="220">
          <ListBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Text}" TextWrapping="Wrap" /></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasHoldingSelection}">
          <TextBlock Text="Sell" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding SellCounts}" SelectedItem="{Binding SellCount}" MinWidth="90" />
          <TextBlock Text="shares" VerticalAlignment="Center" />
          <Button Content="Sell" Command="{Binding SellCommand}" />
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- the market -->
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto">
      <TextBlock Text="Airlines on the market" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
      <TextBox Grid.Row="1" Text="{Binding Search}" Watermark="airline name, code or country (most valuable first)" Margin="0,0,0,6" />
      <ListBox Grid.Row="2" ItemsSource="{Binding Market}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="Auto,10,*" Margin="2">
              <Image Source="{Binding LogoPath, Converter={x:Static v:LogoConverter.Instance}, ConverterParameter=96}" Width="48" Height="26" Stretch="Uniform" />
              <StackPanel Grid.Column="2">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Numbers}" Opacity="0.7" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="3" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding HasSelection}">
        <TextBlock Text="{Binding SelectedText}" TextWrapping="Wrap" Opacity="0.85" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Buy" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Counts}" SelectedItem="{Binding BuyCount}" MinWidth="90" />
          <TextBlock Text="shares" VerticalAlignment="Center" />
          <Button Content="Buy" Command="{Binding BuyCommand}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Take over and merge" Command="{Binding MergeCommand}" />
          <Button Content="Take over as subsidiary" Command="{Binding SubsidiaryCommand}" />
        </StackPanel>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
