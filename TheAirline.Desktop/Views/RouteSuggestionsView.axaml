<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.RouteSuggestionsView">
  <Grid ColumnDefinitions="2*,12,3*" RowDefinitions="Auto,*" Margin="0,10,0,0">
    <StackPanel Grid.ColumnSpan="3" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Look again" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" Opacity="0.85" TextWrapping="Wrap" />
      <TextBlock Text="Routes from each aircraft's home base and your busiest airports, forecast with that aircraft and its best number of round trips a day (06:00 to 22:00). Open route leases any gates it needs and schedules the aircraft; Adjust first opens the route planner." Opacity="0.6" TextWrapping="Wrap" />
    </StackPanel>

    <ListBox Grid.Row="1" ItemsSource="{Binding Aircraft}" SelectedItem="{Binding Selected}" IsVisible="{Binding HasAircraft}">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Line}" Opacity="0.75" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Best}" Opacity="0.9" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <ScrollViewer Grid.Row="1" Grid.Column="2">
      <StackPanel Spacing="8" Margin="0,0,12,0">
        <TextBlock Text="No route this aircraft can fly was found from its home base or your busiest airports." IsVisible="{Binding NoSuggestions}" Opacity="0.7" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Suggestions}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#262626" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                             Foreground="{Binding Loses, Converter={x:Static v:ReportWarningBrush.Instance}}" />
                  <TextBlock Text="{Binding Line1}" Opacity="0.8" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Line2}" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Gates}" IsVisible="{Binding HasGates}" Opacity="0.7" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Button Content="Open route" Command="{Binding OpenCommand}" />
                    <Button Content="Adjust first" Command="{Binding AdjustCommand}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
