<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.SubsidiariesView">
  <Grid ColumnDefinitions="*,16,380" Margin="0,10,0,0">

    <!-- your subsidiaries -->
    <ScrollViewer>
      <StackPanel Spacing="8" Margin="0,0,8,0">
        <TextBlock Text="{Binding Explanation}" Opacity="0.75" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
        <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" MaxHeight="320">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="Auto,10,*" Margin="2">
                <Image Source="{Binding LogoPath, Converter={x:Static v:LogoConverter.Instance}, ConverterParameter=96}" Width="48" Height="26" Stretch="Uniform" />
                <StackPanel Grid.Column="2">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Numbers}" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding Transfer}" Width="130" Watermark="amount" />
            <Button Content="Move money to it" Command="{Binding ToSubCommand}" />
            <Button Content="Take money out" Command="{Binding FromSubCommand}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Sell it..." Command="{Binding SellCommand}" />
            <Button Content="Fold into my airline..." Command="{Binding FoldCommand}" />
          </StackPanel>
        </StackPanel>

        <Border IsVisible="{Binding HasPending}" Background="#3a3320" CornerRadius="6" Padding="10">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button Content="Yes" Command="{Binding ConfirmCommand}" />
              <Button Content="No" Command="{Binding CancelCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <!-- start a new one -->
    <ScrollViewer Grid.Column="2">
      <StackPanel Spacing="6" Margin="0,0,8,0">
        <TextBlock Text="Start a subsidiary" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="Name" />
        <TextBox Text="{Binding NewName}" MaxLength="60" Watermark="e.g. Lone Star Express" />
        <TextBlock Text="Airline code (2 letters or digits)" />
        <TextBox Text="{Binding NewCode}" MaxLength="2" Width="70" HorizontalAlignment="Left" />
        <TextBlock Text="Home airport" />
        <ComboBox ItemsSource="{Binding Homebases}" SelectedItem="{Binding Homebase}" HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Text="Money to start with" />
        <TextBox Text="{Binding NewMoney}" Width="160" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding MinMoneyText}" Opacity="0.7" TextWrapping="Wrap" FontSize="12" />
        <TextBlock Text="Management style" />
        <ComboBox ItemsSource="{Binding Mentalities}" SelectedItem="{Binding Mentality}" MinWidth="160" />
        <TextBlock Text="Where it flies" />
        <ComboBox ItemsSource="{Binding Markets}" SelectedItem="{Binding Market}" MinWidth="160" />
        <TextBlock Text="Business" />
        <ComboBox ItemsSource="{Binding Focuses}" SelectedItem="{Binding Focus}" MinWidth="160" />
        <Button Content="Start it" Command="{Binding CreateCommand}" Margin="0,6,0,0" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
