<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.ProfitRankingView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="0,10,0,0">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Text="Show" VerticalAlignment="Center" FontWeight="SemiBold" />
      <ComboBox ItemsSource="{Binding WhatChoices}" SelectedItem="{Binding What}" MinWidth="120" />
      <TextBlock Text="over" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding PeriodChoices}" SelectedItem="{Binding Period}" MinWidth="250" />
      <TextBlock Text="how many each way" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding HowManyChoices}" SelectedItem="{Binding HowMany}" MinWidth="80" />
      <Button Content="Open this route" Command="{Binding OpenCommand}" />
    </StackPanel>

    <TextBlock Grid.Row="1" Text="{Binding Summary}" TextWrapping="Wrap" Opacity="0.85" Margin="0,0,0,8" />

    <ScrollViewer Grid.Row="2">
      <v:RankBarChart Data="{Binding}" VerticalAlignment="Top" />
    </ScrollViewer>
  </Grid>
</UserControl>
