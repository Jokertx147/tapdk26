<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheAirline.Desktop.Views.AircraftDealsView">
  <ScrollViewer Margin="0,10,0,0">
    <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
      <Border IsVisible="{Binding HasPending}" Background="#3a3320" CornerRadius="6" Padding="10">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Yes" Command="{Binding ConfirmCommand}" />
            <Button Content="No" Command="{Binding CancelCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <TextBlock Text="Lease an idle aircraft you own to another airline for monthly rent, or put it up for sale at the price you want. A lower price sells faster. Leased-out aircraft cannot fly for you until the lease ends." TextWrapping="Wrap" Opacity="0.75" />
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />

      <TextBlock Text="{Binding LeasedTitle}" FontSize="16" FontWeight="SemiBold" />
      <ItemsControl ItemsSource="{Binding LeasedOut}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#262626" CornerRadius="6" Padding="12" Margin="0,0,0,8">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                <Button Content="{Binding ButtonText}" Command="{Binding Command}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding ListedTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ItemsControl ItemsSource="{Binding Listed}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#262626" CornerRadius="6" Padding="12" Margin="0,0,0,8">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                <Button Content="{Binding ButtonText}" Command="{Binding Command}" HorizontalAlignment="Left" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding AvailableTitle}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
      <ItemsControl ItemsSource="{Binding Available}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="#262626" CornerRadius="6" Padding="12" Margin="0,0,0,10">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Info}" TextWrapping="Wrap" Opacity="0.8" />
                <ItemsControl ItemsSource="{Binding LeaseButtons}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><Button Content="{Binding Text}" Command="{Binding Command}" Margin="0,2" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl ItemsSource="{Binding SaleButtons}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate><Button Content="{Binding Text}" Command="{Binding Command}" Margin="0,2" /></DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
