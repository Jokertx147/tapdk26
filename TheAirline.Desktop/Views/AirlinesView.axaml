<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.AirlinesView">
  <Grid RowDefinitions="Auto,*,Auto" Margin="0,10,0,0">
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
      <TextBlock Text="Airlines" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBox Text="{Binding Search}" Watermark="name, code or country" Width="240" />
      <TextBlock Text="sort by" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SortBy}" MinWidth="120" />
      <Button Content="Refresh" Command="{Binding RefreshCommand}" />
      <TextBlock Text="{Binding Count}" Opacity="0.7" VerticalAlignment="Center" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,10,340">
    <Grid RowDefinitions="Auto,*">
      <Grid ColumnDefinitions="2.4*,0.5*,1.6*,0.6*,0.6*,0.7*,0.8*,1.6*" Margin="8,0,8,4" Opacity="0.7">
        <TextBlock Text="Airline" />
        <TextBlock Grid.Column="1" Text="Code" />
        <TextBlock Grid.Column="2" Text="Country" />
        <TextBlock Grid.Column="3" Text="Fleet" />
        <TextBlock Grid.Column="4" Text="Routes" />
        <TextBlock Grid.Column="5" Text="Airports" />
        <TextBlock Grid.Column="6" Text="Size" />
        <TextBlock Grid.Column="7" Text="Alliance" />
      </Grid>
      <ListBox Grid.Row="1" ItemsSource="{Binding Airlines}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="2.4*,0.5*,1.6*,0.6*,0.6*,0.7*,0.8*,1.6*">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Image Source="{Binding LogoPath, Converter={x:Static v:LogoConverter.Instance}, ConverterParameter=64}" Width="36" Height="20" Stretch="Uniform" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding Code}" />
              <TextBlock Grid.Column="2" Text="{Binding Country}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="3" Text="{Binding Fleet}" />
              <TextBlock Grid.Column="4" Text="{Binding Routes}" />
              <TextBlock Grid.Column="5" Text="{Binding Airports}" />
              <TextBlock Grid.Column="6" Text="{Binding Value}" />
              <TextBlock Grid.Column="7" Text="{Binding Alliance}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <ScrollViewer Grid.Column="2" IsVisible="{Binding HasProfile}">
      <StackPanel Spacing="4">
        <Image Source="{Binding ProfileLogo, Converter={x:Static v:LogoConverter.Instance}, ConverterParameter=240}" Height="70" MaxWidth="200" Stretch="Uniform" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding ProfileTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Facts}">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Fleet" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ItemsControl ItemsSource="{Binding FleetLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" Margin="0,1" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="Best routes" FontWeight="SemiBold" Margin="0,8,0,0" />
        <ItemsControl ItemsSource="{Binding RouteLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding}" Margin="0,1" /></DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
    </Grid>

    <TextBlock Grid.Row="2" Text="{Binding Details}" TextWrapping="Wrap" Margin="0,8,0,0" />
  </Grid>
</UserControl>
