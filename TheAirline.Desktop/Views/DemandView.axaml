<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="using:TheAirline.Desktop.Views"
             x:Class="TheAirline.Desktop.Views.DemandView">
  <Grid ColumnDefinitions="280,12,*,12,Auto" RowDefinitions="*,Auto" Margin="0,10,0,0">

    <!-- airport picker -->
    <Grid RowDefinitions="Auto,*">
      <TextBox Text="{Binding Search}" Watermark="search airport, code, town or country (empty = your airports)" Margin="0,0,0,6" />
      <ListBox Grid.Row="1" ItemsSource="{Binding Airports}" SelectedItem="{Binding Selected}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Grid>

    <!-- demand list -->
    <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*,Auto">
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8" />
      <WrapPanel Grid.Row="1" Margin="0,0,0,6">
        <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" MinWidth="130" Margin="0,0,14,0" />
        <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="0,0,6,0" />
        <ComboBox ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortBy}" MinWidth="120" Margin="0,0,14,0" />
        <CheckBox Content="Only destinations I don't fly" IsChecked="{Binding OnlyWithoutRoute}" VerticalAlignment="Center" />
      </WrapPanel>
      <TextBox Grid.Row="2" Text="{Binding DestinationFilter}" Watermark="filter destinations by code, name or country" Margin="0,0,0,6" />
      <ListBox Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Numbers}" Opacity="0.8" />
              <TextBlock Text="{Binding Notes}" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <WrapPanel Grid.Row="4" Margin="0,8,0,0">
        <Button Content="Create route to selected" Command="{Binding CreateCommand}" Margin="0,0,14,6" />
        <TextBlock Text="Scale demand to" VerticalAlignment="Center" Margin="0,0,6,6" />
        <ComboBox ItemsSource="{Binding ScaleChoices}" SelectedItem="{Binding ScalePercent}" MinWidth="80" Margin="0,0,4,6" />
        <TextBlock Text="%" VerticalAlignment="Center" Margin="0,0,8,6" />
        <Button Content="Selected" Command="{Binding ScaleSelectedCommand}" Margin="0,0,6,6" />
        <Button Content="All shown" Command="{Binding ScaleShownCommand}" Margin="0,0,6,6" />
        <Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,0,6" />
      </WrapPanel>
    </Grid>

    <!-- create route -->
    <Border Grid.Column="4" IsVisible="{Binding HasCreate}" Width="340" Background="#262626" CornerRadius="6" Padding="14">
      <ScrollViewer DataContext="{Binding Create}">
        <v:CreateRouteForm />
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="1" Grid.ColumnSpan="5" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" />
  </Grid>
</UserControl>
